{
  "expo": {
    "name": "Crystal Martin Assets",
    "slug": "crystal-martin-assets",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crystalmartin.assets",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Crystal Martin Assets to access your camera to scan asset barcodes and capture equipment condition photos.",
        "NSPhotoLibraryUsageDescription": "Allow Crystal Martin Assets to access your photos to attach equipment inspection records."
      }
    },
    "android": {
      "package": "com.crystalmartin.assets",
      "versionCode": 2,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidCertificates.js",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Crystal Martin Assets to access your camera to scan asset barcodes and capture equipment condition photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to upload equipment condition images."
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "9f0cdd50-81a8-4572-b458-f5ac52e0c2c2"
      }
    }
  }
}